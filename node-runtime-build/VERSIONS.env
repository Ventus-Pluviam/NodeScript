# AutoScript 构建管线冻结版本（换版本 = 一件事一个提交 + 全链回归，见 RISKS.md）
# 取值日期 2026-09-17；全部经官方渠道实抓校验（nodejs.org / dl.google.com repository2-3.xml）。

# ── Node.js 24 LTS（Krypton）────────────────────────────────────────────
# v24.21.0：2026-09-07 发布，v24 线当前最新（nodejs.org/dist/index.json 实测）。
# npm 11.19.0 / v8 13.6.233.17 / uv 1.52.1（索引实抓；vendored npm 12 见设计 §10 另行升级）。
NODE_VERSION=v24.21.0
# node-v${NODE_VERSION}.tar.xz —— nodejs.org/dist/v24.21.0/SHASUMS256.txt 实测
NODE_SHA256=a6f54defb6fd7c84f41dba13d61e78e9b4e0961712cf61f29715c05f5ced94fc

# ── Android NDK 版本锁 ──────────────────────────────────────────────────
# 锁 r28c（r28 线最新；r28d=404 不存在）。r28+ 链接器默认 16KB ELF 对齐（官方 page-sizes 指南），
# 故无需手工 -z 旗标；r27d 备选方案（需显式 -Wl,-z,max-page-size=16384）见 RISKS.md。
NDK_VERSION=r28c
# 版本串 / zip 大小 / sha1 来自 dl.google.com repository2-3.xml（sdkmanager 同源，实测 2026-09-17）
NDK_VERSION_CODE=28.2.13676358
NDK_ZIP_SIZE=722261334
NDK_SHA1=a7b54a5de87fecd125a17d54f73c446199e72a64

# ── 目标 ABI 面 ─────────────────────────────────────────────────────────
# Bionic API：与根 Gradle catalog 冻结 minSdk 26 对齐（改 minSdk 必须同步此处）
ANDROID_API=26
TARGET_ARCH=arm64
# Node 24 共享库 ABI 号（设计 §575：NODE_MODULE_VERSION=137；预编译 .node addon 必须同号）
EXPECTED_NODE_MODULE_VERSION=137

# 构建工作目录（Docker/CI 注入；勿含空格）
WORK_DIR="${WORK_DIR:-/build}"
# ── OpenCV 4.14.0（libimgnative.so 静态链接，docs §9.2）──────────────────
# 选型依据（源码逐点实测，非 release note）：
#   - carotene 的 NEON matchTemplate 门槛 width>=8 且 width*height<=256（4.8/4.14 逐字节相同）
#     —— 正常按钮模板即超出；4.14 起 matchTemplate 入口改走 cv_hal_matchTemplate（4.8 没有这条），
#     但 hal_ni_matchTemplate 仍是 CV_HAL_ERROR_NOT_IMPLEMENTED 死桩，故 arm64 实际仍走通用 C。
#   - 4.14 的 NEON_DOTPROD 运行时分派（-march=armv8.2-a+dotprod）只覆盖 matmul/reduce/norm，
#     不含 templmatch/imgproc；imgproc 两版含 NEON 的 dispatch 条目均为空。
#   - kleidicv（AArch64+Android 默认 ON）覆盖 minMaxIdx/add/subtract/absdiff/multiply/bitwise_and/
#     exp/inRange/cvtColor/convertTo/GaussianBlur/Sobel/medianBlur/sepFilter2D/dilate/erode/resize/
#     pyrDown/transpose/rotate/remap/warpPerspective —— **不含 matchTemplate/imdecode**（上游
#     doc/opencv.md 实证）。开着是给未来算子铺路 + 现状不亏，不是为 matchTemplate。
#   - 下载是软降级（ocv_download 带 STATUS res，失败只 WARNING），产物仍可比；ON/OFF 由
#     build-opencv.sh 3b 段按 configure 摘要的 `Custom HAL: … KleidiCV (ver …)` 判定
#     （**不是** CMakeCache 的 HAVE_KLEIDICV —— 上游只 set 普通变量、无 CACHE， cache 里
#     根本没这一项；2026-09-25 曾因此把"已启用"误报成 OFF 两轮），写进 SHASUMS256 审计行。
OPENCV_VERSION=4.14.0
# 4.14.0 tag → commit（git clone -c advice.detachedHead=false checkout）
OPENCV_COMMIT=0654a42e19215ef25b1d367d822f3c630447e7c7
# KleidiCV pin（opencv/hal/kleidicv/kleidicv.cmake 的 ocv_update 值，md5 是 ocv_download 校验源）
KLEIDICV_COMMIT=26.03
KLEIDICV_MD5=b85a745bfe0e87e67e30be9533eb6b24
# 只编三个模块：nav 面只需要 core + imgproc（matchTemplate） + imgcodecs（imdecode）。
# IMGCODECS_* 的格式开关在 build-opencv.sh 里逐项 OFF，保留 PNG/JPEG 两条（截图与资源图就这两种）。
OPENCV_BUILD_LIST=core,imgproc,imgcodecs
