  "aliases": {
    "findOneOrNull": {
      "ns": "a11y",
      "why": "宿主保留的同名分支；facade 实际发 findOne 并把 ERR_NOT_FOUND 本地折成 null（a11y.ts findOneOrNull），wire 上不会出现这个名字"
    },
    "shell": {
      "ns": "shell",
      "why": "extras.ts 的 shell.shell() 是 exec 的 JS 别名，wire 只发 exec（宿主 shell/exec 两个标签同体，方法名 shell 无人发）"
    }
  },
  "dynamicSinks": [
    {
      "file": "a11y.ts",
      "ns": "a11y",
      "form": "call",
      "why": "wrapUiObject 的代理把动作名当字面量传给 call(method, …)，不是第二个 invoke 实参（解析器按 form 映射正则）"
    }
  ]
