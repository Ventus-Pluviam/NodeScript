<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 启动入口（launcher 随库 manifest 合并进 :app，AGP 处理）。
         主题 = 本模块 res 的 Theme.AutoScript（parent 是平台自带 Material[.Light].NoActionBar）：
         仓库无 appcompat 依赖，只能挂平台主题；深浅两版由 values-night 分派，
         用来对齐窗口背景（见 res/values*/themes.xml）。不声明会让设备默认主题带出 ActionBar。 -->
    <application>
        <activity
            android:name="com.autoscript.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AutoScript">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
